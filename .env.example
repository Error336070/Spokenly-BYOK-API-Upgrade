# Copy to .env and fill in. Never commit .env.

# OpenRouter (stage 1-5 backend)
OPENROUTER_API_KEY=sk-or-v1-...

# Optional: if set, Spokenly must send this as its API key. If empty, any key is accepted
# (the server only listens on 127.0.0.1 anyway).
PROXY_API_KEY=

# Native backends (used by routes set to backend: native)
ASSEMBLYAI_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=northeurope
# Optional: your resource's own endpoint instead of the regional one, e.g. https://<name>.cognitiveservices.azure.com
AZURE_SPEECH_ENDPOINT=
